[Unit]
Description=Temporary Pacers Registry fallback (remove after cloud recovery)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
UMask=0077
RuntimeDirectory=pacers
RuntimeDirectoryMode=0700
ExecStartPre=/usr/bin/python3 /opt/pacers/prepare.py
ExecStartPre=-/usr/bin/docker rm -f pacers
ExecStart=/bin/sh -c 'exec /usr/bin/docker run --name pacers --init --read-only --tmpfs /tmp:rw,noexec,nosuid,size=64m --cap-drop=ALL --security-opt=no-new-privileges --memory=512m --pids-limit=128 --log-opt max-size=10m --log-opt max-file=3 --publish 127.0.0.1:8080:8080 --env-file /run/pacers/app.env "$(cat /run/pacers/image)"'
ExecStop=/usr/bin/docker stop --time 20 pacers
Restart=always
RestartSec=15
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
